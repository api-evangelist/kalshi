        {
          "id": "9bab6eac-bdc4-4c20-a032-a9ac7ea57fc6",
          "name": "Get FCM Orders",
          "request": {
            "name": "Get FCM Orders",
            "description": {
              "content": "Endpoint for FCM members to get orders filtered by subtrader ID.\nThis endpoint requires FCM member access level and allows filtering orders by subtrader ID.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "fcm",
                "orders"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "subtrader_id",
                  "value": "<string>",
                  "description": "(Required) Restricts the response to orders for a specific subtrader (FCM members only)"
                },
                {
                  "disabled": false,
                  "key": "cursor",
                  "value": "<string>",
                  "description": "Pagination cursor. Use the cursor value returned from the previous response to get the next page of results. Leave empty for the first page."
                },
                {
                  "disabled": false,
                  "key": "event_ticker",
                  "value": "<string>",
                  "description": "Event ticker to filter by. Only a single event ticker is supported."
                },
                {
                  "disabled": false,
                  "key": "ticker",
                  "value": "<string>",
                  "description": "Filter by market ticker"
                },
                {
                  "disabled": false,
                  "key": "min_ts",
                  "value": "<long>",
                  "description": "Restricts the response to orders after a timestamp, formatted as a Unix Timestamp"
                },
                {
                  "disabled": false,
                  "key": "max_ts",
                  "value": "<long>",
                  "description": "Restricts the response to orders before a timestamp, formatted as a Unix Timestamp"
                },
                {
                  "disabled": false,
                  "key": "status",
                  "value": "<string>",
                  "description": "Restricts the response to orders that have a certain status"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Parameter to specify the number of results per page. Defaults to 100"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "KALSHI-ACCESS-KEY"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            }
